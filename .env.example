# Copy jadi .env, isi sesuai mesin kamu. .env tidak pernah di-commit
# (lihat .gitignore) — bisa memuat MENGDEP_INITIAL_PASSWORD.

MENGDEP_LISTEN_ADDR=127.0.0.1:3000
MENGDEP_DB_PATH=./data/mengdep.db

# Wajib — path kunci age, mode 0600. Generate: age-keygen -o key.age
MENGDEP_KEY_PATH=./key.age

# Wajib tmpfs. Default /run/platform/ssh kalau baris ini dikosongkan/dihapus.
# Override eksplisit kalau /run tidak ada di mesin kamu (mis. dev macOS).
MENGDEP_RUNTIME_DIR=/tmp/mengdep-runtime

# Seed password login pertama kali. Hapus baris ini setelah berhasil login.
MENGDEP_INITIAL_PASSWORD=ganti-ini
